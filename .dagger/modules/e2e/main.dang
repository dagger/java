"""
End-to-end coverage of Maven reactors, lifecycle phases, and configuration.
"""
type E2e {
  let assert(ok: Boolean!, message: String!): Void {
    if (ok == false) { raise message }
    null
  }

  let run(check: Check!): Void {
    if (check.pass == false) { raise check.error.message ?? "check failed" }
    null
  }

  let fixture(ws: Workspace!): Directory! {
    ws.directory("/maven/testdata/reactor")
  }

  # Deliberately failing classes prove that a selection does not run neighboring
  # tests, including a dependency module's class with exactly the same name.
  let classFixture(ws: Workspace!): Directory! {
    let source = fixture(ws)
    source
      .withNewFile(
        "library/pom.xml",
        source.file("library/pom.xml").contents.replace(
          old: "</project>",
          new: "<dependencies><dependency><groupId>junit</groupId><artifactId>junit</artifactId></dependency></dependencies></project>",
        ),
      )
      .withNewFile(
        "pom.xml",
        source.file("pom.xml").contents.replace(
          old: "<systemPropertyVariables>",
          new: "<includes><include>**/*.java</include></includes><systemPropertyVariables>",
        ),
      )
      .withNewFile("library/src/test/java/example/AppTest.java", """
        package example;
        public class AppTest {
          @org.junit.Test public void fails() { org.junit.Assert.fail("dependency class must not run"); }
        }
      """)
      .withNewFile("app/src/test/java/example/OtherTest.java", """
        package example;
        public class OtherTest {
          @org.junit.Test public void fails() { org.junit.Assert.fail("unselected class must not run"); }
        }
      """)
      .withNewFile("app/src/test/java/example/SecondTest.java", """
        package example;
        public class SecondTest {
          @org.junit.Test public void passes() { org.junit.Assert.assertEquals("hello", Greeting.message()); }
        }
      """)
      .withNewFile("library/src/test/java/example/LibraryTest.java", """
        package example;
        public class LibraryTest {
          @org.junit.Test public void passes() { org.junit.Assert.assertEquals("hello", Greeting.message()); }
        }
      """)
  }

  # The complete verdict of every reactor, through the plain collection helper.
  let verified(tool: Maven!, ws: Workspace!): String! {
    { tool.projects(ws).verify(ws); "passed" } rescue {
      err: Error => err.message
    }
  }

  # Module and class keys, one "module class" string per test class.
  let classKeys(modules: MavenModules!): [String!]! {
    let empty: [String!]! = []
    modules.keys.reduce(empty) { keys, module =>
      keys + modules.get(key: module).tests.keys.map { name => module + " " + name }
    }
  }

  """
  Class discovery follows conventional Java paths and configurable filename patterns.
  """
  testClassDiscovery: Void @check {
    let source = directory
      .withNewFile("pom.xml", "<project/>")
      .withNewFile("src/test/java/TestDefault.java", "// default package")
      .withNewFile("app/pom.xml", "<project/>")
      .withNewFile("app/src/test/java/example/AppTest.java", "// test")
      .withNewFile("app/src/test/java/example/AppTests.java", "// tests")
      .withNewFile("app/src/test/java/example/AppTestCase.java", "// test case")
      .withNewFile("app/src/test/java/example/TestApp.java", "// prefix")
      .withNewFile("app/src/test/java/example/TestBothTest.java", "// matches two patterns")
      .withNewFile("app/src/test/java/example/AppIT.java", "// integration test")
      .withNewFile("app/src/test/java/example/Helper.java", "// helper")
      .withNewFile("app/src/main/java/example/ProductionTest.java", "// production")
      .withNewFile("app/target/generated-test-sources/GeneratedTest.java", "// generated")
    let project = maven.project(".")
    let expected = [
      ". TestDefault", "app example.AppTest", "app example.AppTestCase",
      "app example.AppTests", "app example.TestApp", "app example.TestBothTest",
    ]
    assert(project.modules(source.asWorkspace).keys == [".", "app"], "incorrect module discovery")
    assert(classKeys(project.modules(source.asWorkspace)) == expected, "incorrect conventional test class discovery")
    assert(
      classKeys(project.modules(source.asWorkspace(cwd: "/app/src/test/java"))) == expected,
      "class keys changed with workspace cwd",
    )
    let nested = directory.withDirectory("nested/reactor", source).asWorkspace
    assert(
      classKeys(maven.project("nested/reactor").modules(nested)) == expected
        .map { key => "nested/reactor/" + key }
        .map { key => key.replace(old: "nested/reactor/. ", new: "nested/reactor ") },
      "module keys were not workspace relative",
    )
    assert(
      classKeys(
        maven.project(".").modules(directory.withNewFile("pom.xml", "<project/>").asWorkspace),
      ).isEmpty,
      "invented test classes",
    )
    let custom = source
      .withNewFile("app/src/spec/java/example/FeatureSpec.java", "// spec")
      .withNewFile("app/src/spec/java/example/ExcludedSpec.java", "// excluded")
      .withNewFile("app/src/spec/java/package-info.java", "// package metadata")
    let tool = maven(
      testSourceDirectory: "src/spec/java",
      testIncludes: ["**/*.java"],
      testExcludes: ["**/ExcludedSpec.java"],
    )
    assert(
      classKeys(tool.project(".").modules(custom.asWorkspace)) == ["app example.FeatureSpec"],
      "custom discovery patterns failed",
    )
    let selected = project.modules(source.asWorkspace).get(key: "app").tests.get(key: "example.AppTest")
    assert(selected.module == "app" and selected.name == "example.AppTest", "incorrect class metadata")
    null
  }

  """
  Run a class subset once, without running unselected classes in any module.
  Selected tests ignore -Dtest from module arguments.
  """
  testClassSelection(ws: Workspace!): Void @check {
    # A nested reactor also exercises mapping workspace keys to module POMs.
    # Unselected failing classes, the dependency's same-named class, and POM
    # includes that would run AppIT all fail the helper if they escape.
    let source = directory.withDirectory("nested/reactor", classFixture(ws)).asWorkspace
    let project = maven(cacheKey: "maven-e2e-class-selection", args: ["-Dtest=example.OtherTest"]).project("nested/reactor")
    let modules = project.modules(source)
    modules.get(key: "nested/reactor/app").tests.subset(keys: ["example.AppTest", "example.SecondTest"]).test(source)
    modules.get(key: "nested/reactor/library").tests.subset(keys: ["example.LibraryTest"]).test(source)
    modules.get(key: "nested/reactor/app").tests.subset(keys: []).test(source)
    let failed = {
      modules.get(key: "nested/reactor/app").tests.subset(keys: ["example.OtherTest"]).test(source)
      "passed"
    } rescue {
      err: Error => err.message
    }
    assert(failed.contains("unselected class must not run"), "a failing class did not fail its helper: " + failed)
    null
  }

  """
  Root-module selection includes a JUnit 5 class's parameterized and nested tests.
  """
  testClassJunit5: Void @check {
    let source = directory
      .withNewFile("pom.xml", """
        <project xmlns="http://maven.apache.org/POM/4.0.0">
          <modelVersion>4.0.0</modelVersion>
          <groupId>io.dagger.maven.fixture</groupId><artifactId>junit5</artifactId><version>1</version>
          <properties><maven.compiler.release>17</maven.compiler.release></properties>
          <dependencies><dependency>
            <groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>5.11.4</version><scope>test</scope>
          </dependency></dependencies>
          <build>
            <testSourceDirectory>src/spec/java</testSourceDirectory>
            <plugins>
              <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.14.1</version></plugin>
              <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.5.4</version></plugin>
            </plugins>
          </build>
        </project>
      """)
      .withNewFile("src/spec/java/example/ExampleSpec.java", """
        package example;
        public class ExampleSpec {
          @org.junit.jupiter.params.ParameterizedTest
          @org.junit.jupiter.params.provider.ValueSource(strings = {"a", "b"})
          void parameterized(String value) { org.junit.jupiter.api.Assertions.assertEquals("a", value, "parameterized sentinel"); }

          @org.junit.jupiter.api.Nested
          class NestedTests {
            @org.junit.jupiter.api.Test
            void nested() { org.junit.jupiter.api.Assertions.fail("nested sentinel"); }
          }
        }
      """)
      .withNewFile("src/spec/java/example/UnselectedSpec.java", """
        package example;
        public class UnselectedSpec {
          @org.junit.jupiter.api.Test
          void fails() { org.junit.jupiter.api.Assertions.fail("unselected JUnit 5 test ran"); }
        }
      """)
      .asWorkspace
    let project = maven(
      cacheKey: "maven-e2e-class-junit5",
      testSourceDirectory: "src/spec/java",
      testIncludes: ["**/*Spec.java"],
    ).project(".")
    # Sentinel failures prove that parameterized and nested cases ran and that
    # both are attributed to the outer class.
    let result = {
      project.modules(source).get(key: ".").tests.subset(keys: ["example.ExampleSpec"]).test(source)
      "passed"
    } rescue {
      err: Error => err.message
    }
    assert(result.contains("parameterized sentinel"), "parameterized cases did not run: " + result)
    assert(result.contains("nested sentinel"), "nested tests did not run: " + result)
    assert(result.contains("unselected JUnit 5 test ran") == false, "ran an unselected JUnit 5 class")
    assert(result.contains("without selected test checks") == false, "nested results were not attributed: " + result)
    null
  }

  """
  Selected failures propagate, and skipped classes cannot silently pass.
  """
  testClassFailures(ws: Workspace!): Void @check {
    let source = classFixture(ws).asWorkspace
    let tests = maven(cacheKey: "maven-e2e-class-failures", args: ["-Dmaven.test.failure.ignore=true"])
      .project(".")
      .modules(source)
      .get(key: "app")
      .tests
    let failed = { tests.subset(keys: ["example.OtherTest"]).test(source); "passed" } rescue {
      err: Error => err.message
    }
    assert(failed != "passed", "a selected failing class passed")
    let unknown = { tests.subset(keys: ["example.UnknownTest"]).test(source); "passed" } rescue {
      err: Error => err.message
    }
    assert(unknown != "passed", "an unknown class passed")
    let skipped = {
      maven(cacheKey: "maven-e2e-class-failures", args: ["-DskipTests"])
        .project(".")
        .modules(source)
        .get(key: "app")
        .tests
        .subset(keys: ["example.AppTest"])
        .test(source)
      "passed"
    } rescue {
      err: Error => err.message
    }
    assert(skipped.contains("did not run"), "a skipped class silently passed: " + skipped)
    # Full verify must still run classes omitted from discovery.
    let hidden = maven(cacheKey: "maven-e2e-class-failures", testExcludes: ["**/OtherTest.java", "**/AppTest.java"])
    assert(verified(hidden, source) != "passed", "discovery filters weakened the complete verify verdict")
    null
  }

  """
  Discovery avoids duplicate reactors, honors cwd, and supports explicit roots.
  """
  discovery: Void @check {
    let source = directory
      .withNewFile("one/pom.xml", "<project/>")
      .withNewFile("one/child/pom.xml", "<project/>")
      .withNewFile("two/pom.xml", "<project/>")
      .withNewFile("one/target/generated/pom.xml", "<project/>")
      .withNewFile(".m2/pom.xml", "<project/>")
      .withNewFile("one/child/src/Main.java", "// source")
    let ws = source.asWorkspace
    assert(maven.projects(ws).keys == ["one", "two"], "expected two reactor roots")
    assert(
      maven.projects(source.asWorkspace(cwd: "/one/child/src")).keys == ["one"],
      "cwd inside a member must retain the enclosing reactor",
    )
    assert(
      maven(roots: ["one/child", "two"]).projects(ws).keys == ["one/child", "two"],
      "explicit roots did not override discovery",
    )
    assert(maven.projects(directory.asWorkspace).keys.isEmpty, "empty workspace invented a project")
    let invalid = { maven.project("../escape").path } rescue {
      err: Error => err.message
    }
    assert(invalid.contains("workspace-relative"), "accepted a path outside the workspace")
    let missing = { maven.project("missing").container(ws).sync; "passed" } rescue {
      err: Error => err.message
    }
    assert(missing.contains("no pom.xml"), "missing POM was not diagnosed")
    null
  }

  """
  Host targets are excluded while Maven config, sources, and siblings survive.
  """
  sourcePolicy: Void @check {
    let ws = directory
      .withNewFile("pom.xml", "<project/>")
      .withNewFile(".mvn/maven.config", "-Pci")
      .withNewFile("mvnw", "#!/bin/sh\n")
      .withNewFile("child/src/main/resources/config.txt", "resource")
      .withNewFile("sibling/pom.xml", "<project/>")
      .withNewFile("target/stale.jar", "stale")
      .withNewFile("child/target/stale.jar", "stale")
      .withNewFile(".m2/settings.xml", "host settings")
      .withNewFile(".git/config", "host git config")
      .asWorkspace
    let source = maven.source(ws)
    assert(source.glob("**/target/**").isEmpty, "host targets leaked into source")
    assert(source.glob("**/.m2/**").isEmpty, "host Maven home leaked into source")
    assert(source.glob("**/.git/**").isEmpty, "host git data leaked into source")
    assert(source.file(".mvn/maven.config").contents == "-Pci", "lost Maven config")
    assert(source.file("sibling/pom.xml").contents == "<project/>", "lost sibling POM")
    assert(
      source.file("child/src/main/resources/config.txt").contents == "resource",
      "lost resources",
    )
    null
  }

  """
  Wrapper choice, literal arguments, custom base, secrets, and toolchains.
  """
  configuration: Void @check {
    let source = directory
      .withNewFile("pom.xml", "<project/>")
      .withNewFile("mvnw", "#!/bin/sh\nprintf 'wrapper\\n'\nprintf '%s\\n' \"$@\"\n")
    let base = container
      .from("alpine:3.23")
      .withNewFile(
        "/usr/local/bin/mvn",
        "#!/bin/sh\nprintf 'maven\\n'\nprintf '%s\\n' \"$@\"\n",
        permissions: 493,
      )
    let tool = maven(
      base: base,
      args: ["-Pci", "-Dmessage=a value; $(not-a-command)"],
      settings: setSecret("maven-e2e-settings", "<settings/>"),
      toolchains: directory.withNewFile("toolchains.xml", "<toolchains/>").file("toolchains.xml"),
      cacheKey: "maven-e2e-configuration",
    )
    let result = tool.project(".").run(source.asWorkspace, ["validate"], args: ["-pl", "app", "-am"])
    let output = result.stdout
    assert(output.hasPrefix("wrapper\n"), "did not prefer non-executable wrapper")
    assert(output.contains("-Dmessage=a value; $(not-a-command)\n"), "arguments were split or shell-expanded")
    assert(output.contains("--batch-mode\n--no-transfer-progress\n"), "missing CI flags")
    assert(output.contains("-pl\napp\n-am\n"), "lost reactor selection flags")
    assert(output.contains("--settings\n/maven-settings.xml\n"), "missing settings argument")
    assert(output.contains("--toolchains\n/maven-toolchains.xml\n"), "missing toolchains argument")
    result.withExec(["sh", "-eu", "-c", "test -f /maven-settings.xml; test -f /maven-toolchains.xml; test \"$MAVEN_USER_HOME\" = /maven"]).sync
    assert(
      maven(base: base, useWrapper: false).project(".").run(
        source.asWorkspace,
        ["validate"],
      ).stdout.hasPrefix("maven\n"),
      "useWrapper=false did not force Maven",
    )
    assert(
      maven(base: base).project(".").run(
        source.withoutFile("mvnw").asWorkspace,
        ["validate"],
      ).stdout.hasPrefix("maven\n"),
      "missing wrapper did not fall back to Maven",
    )
    let empty = { tool.project(".").run(source.asWorkspace, []).sync; "passed" } rescue {
      err: Error => err.message
    }
    assert(empty.contains("at least one Maven goal"), "accepted empty goals")
    null
  }

  """
  Compile, test, package and verify a reactor with an inter-module dependency.
  """
  lifecycle(ws: Workspace!): Void @check {
    let project = maven(cacheKey: "maven-e2e-reactor").project(".")
    let source = fixture(ws).withNewFile("app/target/host-only.txt", "must not enter build").asWorkspace
    project.compile(source).file("app/target/classes/example/App.class").sync
    project.test(source).file("app/target/surefire-reports/TEST-example.AppTest.xml").sync
    let outputs = project.build(source)
    outputs.file("library/target/library-1.0-SNAPSHOT.jar").sync
    outputs.file("app/target/app-1.0-SNAPSHOT.jar").sync
    assert(outputs.glob("**/host-only.txt").isEmpty, "build reused host targets")
    run(project.verify(source))
    let reports = project.reports(source)
    assert(
      reports.file("app/target/surefire-reports/TEST-example.AppTest.xml").contents.contains("tests=\"1\""),
      "unit test did not run",
    )
    assert(
      reports.file("app/target/failsafe-reports/TEST-example.AppIT.xml").contents.contains("tests=\"1\""),
      "integration test did not run",
    )
    assert(reports.glob("**/*.jar").isEmpty, "reports included artifacts")
    null
  }

  """
  Failures propagate from both Surefire and Failsafe, including collection verify.
  """
  failures(ws: Workspace!): Void @check {
    let source = fixture(ws)
    let badUnit = source.withNewFile("app/src/test/java/example/AppTest.java", """
      package example;
      public class AppTest {
        @org.junit.Test public void fails() { org.junit.Assert.fail("unit sentinel"); }
      }
    """).asWorkspace
    let badIntegration = source.withNewFile(
      "app/src/test/java/example/AppIT.java",
      """
        package example;
        public class AppIT {
          @org.junit.Test public void fails() { org.junit.Assert.fail("integration sentinel"); }
        }
      """,
    ).asWorkspace
    let tool = maven(cacheKey: "maven-e2e-failures")
    assert(verified(tool, badUnit) != "passed", "unit test failure passed verify")
    assert(verified(tool, badIntegration) != "passed", "integration failure passed verify")
    # app/example.AppTest's check owns both failures, so the reactor's own
    # verify check does not report them a second time.
    assert(tool.project(".").verify(badUnit).pass, "verify also failed for a unit test its class check owns")
    assert(tool.project(".").verify(badIntegration).pass, "verify also failed for a failure class checks own")
    assert(
      tool.project(".").reports(badUnit).file("app/target/surefire-reports/TEST-example.AppTest.xml").contents.contains("failures=\"1\""),
      "could not export reports from failing unit tests",
    )
    assert(
      tool.project(".").reports(badIntegration).file("app/target/failsafe-reports/TEST-example.AppIT.xml").contents.contains("failures=\"1\""),
      "could not export reports from failing integration tests",
    )
    let reactors = directory
      .withDirectory("bad-unit", source.withDirectory(".", badUnit.directory("/")))
      .withDirectory("bad-integration", badIntegration.directory("/"))
      .asWorkspace
    let message = { tool.projects(reactors).verify(reactors); "passed" } rescue {
      err: Error => err.message
    }
    assert(message != "passed", "failing reactors passed collection verify")
    assert(
      message.contains("- bad-unit:") and message.contains("- bad-integration:"),
      "collection verify did not report both reactors: " + message,
    )
    null
  }

  """
  A generated Apache wrapper selects its pinned version and builds a single module.
  """
  wrapper(ws: Workspace!): Void @check {
    let tool = maven(cacheKey: "maven-e2e-wrapper")
    let generated = tool.project(".").run(
      fixture(ws).asWorkspace,
      ["org.apache.maven.plugins:maven-wrapper-plugin:3.3.4:wrapper"],
      args: ["-N", "-Dmaven=3.9.9", "-Dtype=only-script"],
    ).directory("/src").asWorkspace
    assert(
      tool.project(".").run(generated, ["--version"]).stdout.contains("Apache Maven 3.9.9"),
      "the real wrapper did not select its pinned Maven version",
    )
    # A standalone library build still sees its parent POM outside its root.
    tool.project("library").build(generated).file("target/library-1.0-SNAPSHOT.jar").sync
    null
  }

  """
  Install artifacts and deploy only to a disposable container-local repository.
  """
  publishing(ws: Workspace!): Void @check {
    let source = fixture(ws).asWorkspace
    let project = maven(cacheKey: "maven-e2e-publishing").project(".")
    let installed = project.install(source)
    installed.withExec(["test", "-f", "/maven/repository/io/dagger/maven/fixture/app/1.0-SNAPSHOT/app-1.0-SNAPSHOT.jar"]).sync
    let output = project.deploy(source, args: ["-DaltDeploymentRepository=fixture::file:///tmp/deployed"])
    assert(output.contains("BUILD SUCCESS"), "file repository deployment did not succeed")
    null
  }

  # Only the unindented CHECKS header counts; test summaries can be nested.
  let checkSummaryMatches(output: String!, passed: Int!, failed: Int!): Boolean! {
    let headers = output.split("\n").filter { line =>
      line.hasPrefix("CHECKS ") or line.hasPrefix("== CHECKS ==")
    }
    # Counts are bound first: dang fmt v2.1.4 mangles an interpolation that
    # follows a non-ASCII string in a list literal.
    let failedCount = `${failed}`
    let passedCount = `${passed}`
    let expected = (if (failed > 0) { ["✘", failedCount, "failed"] } else { [] })
      + (if (passed > 0) { ["✔", passedCount, "passed"] } else { [] })
    headers.length == 1 and headers[0]!
      .trimPrefix("== ")
      .trimPrefix("CHECKS")
      .trimPrefix(" ==")
      .trimSpace
      .split(" ")
      .filter { word => word != "" } == expected
  }

  """
  The check-summary parser counts only the top-level CHECKS header.
  """
  selectedSummaryCheck: Void @check {
    assert(
      checkSummaryMatches("== CHECKS ==  ✘ 3 failed  ✔ 3 passed\n", 3, 3),
      "mixed counts were not recognized",
    )
    assert(checkSummaryMatches("== CHECKS ==  ✔ 6 passed\n", 6, 0), "passing counts were not recognized")
    assert(
      checkSummaryMatches("== CHECKS ==  ✔ 16 passed\n", 6, 0) == false,
      "accepted a partial count",
    )
    assert(checkSummaryMatches("  CHECKS  ✔ 6 passed\n", 6, 0) == false, "accepted a nested header")
    null
  }

  # Run dagger check through the engine-provided, version-matched CLI in an
  # isolated session: direct Dang calls do not apply the engine's filtered
  # collection view, so only this exercises what selected checks receive.
  let selectedRun(ws: Workspace!, fixture: Directory!, args: [String!]!): Container! {
    container
      .from("alpine:3.23")
      .withEnvVariable("NO_COLOR", "1")
      .withDirectory("/source", ws.directory("/maven", exclude: ["**/target/**"]))
      .withDirectory("/work", fixture)
      .withNewFile("/work/.git/HEAD", "ref: refs/heads/main\n")
      .withNewFile("/work/dagger.toml", "[modules.maven]\nsource = \"/source\"\n")
      .withWorkdir("/work")
      .withExec(
        ["/dev/.dagger/dagger", "check", "--generated=false"] + args,
        expect: ANY,
        daggerInDaggerNewSession: true,
      )
  }

  let selectedCheck(
    ws: Workspace!,
    fixture: Directory!,
    args: [String!]!,
    passed: Int!,
    failed: Int! = 0,
    messages: [String!]! = [],
  ): Void {
    let result = selectedRun(ws, fixture, ["--progress=report"] + args)
    let output = result.stdout + result.stderr
    assert((result.exitCode == 0) == (failed == 0), "unexpected check exit status:\n" + output)
    assert(checkSummaryMatches(output, passed, failed), "unexpected Dagger check totals:\n" + output)
    messages.map { message =>
      assert(output.contains(message), "missing " + message + ":\n" + output)
    }
    null
  }

  let javaClass(name: String!, body: String!): String! {
    "package example;\npublic class " + name + " {\n  @org.junit.Test public void run() { " + body + " }\n}\n"
  }

  # Two reactors, each with two modules. Every selected class passes.
  let passingFixture(ws: Workspace!): Directory! {
    let reactor = fixture(ws)
    let withLibraryTests = reactor
      .withNewFile(
        "library/pom.xml",
        reactor.file("library/pom.xml").contents.replace(
          old: "</project>",
          new: "<dependencies><dependency><groupId>junit</groupId><artifactId>junit</artifactId></dependency></dependencies></project>",
        ),
      )
      .withNewFile("app/src/test/java/example/SecondTest.java", javaClass(
        "SecondTest",
        "org.junit.Assert.assertEquals(\"hello\", Greeting.message());",
      ))
      .withNewFile("library/src/test/java/example/LibraryTest.java", javaClass(
        "LibraryTest",
        "org.junit.Assert.assertEquals(\"hello\", Greeting.message());",
      ))
    directory.withDirectory("one", withLibraryTests).withDirectory("two", withLibraryTests)
  }

  # Unselected classes fail if they run, in both modules of both reactors.
  let selectionFixture(ws: Workspace!): Directory! {
    ["one/app", "one/library", "two/app", "two/library"].reduce(passingFixture(ws)) { files, module =>
      files.withNewFile(
        module + "/src/test/java/example/OtherTest.java",
        javaClass("OtherTest", "org.junit.Assert.fail(\"excluded test ran\");"),
      )
    }
  }

  let selectionArgs: [String!]! {
    ["one/app", "one/library", "two/app", "two/library"].map { module => "--maven-module=" + module }
      + ["example.AppTest", "example.SecondTest", "example.LibraryTest"].map { name => "--maven-test=" + name }
  }

  """
  Selected classes across reactors and modules pass; excluded classes do not run.
  """
  selectedTestsCheck(ws: Workspace!): Void @check {
    selectedCheck(ws, selectionFixture(ws), selectionArgs, passed: 6)
  }

  """
  An unselected run checks every class and verifies each reactor.
  """
  selectedWholeCheck(ws: Workspace!): Void @check {
    selectedCheck(ws, passingFixture(ws), [], passed: 8)
  }

  """
  A failing selected class fails only its own check.
  """
  selectedFailureCheck(ws: Workspace!): Void @check {
    let fixture = selectionFixture(ws)
      .withNewFile("one/app/src/test/java/example/AppTest.java", javaClass(
        "AppTest",
        "org.junit.Assert.fail(\"selected failure\");",
      ))
    selectedCheck(
      ws,
      fixture,
      selectionArgs,
      passed: 5,
      failed: 1,
      messages: ["maven-module=one/app&maven-test=example.AppTest", "selected failure"],
    )
  }

  """
  A compilation failure fails its module's classes; dependents did not run.
  """
  selectedBuildFailureCheck(ws: Workspace!): Void @check {
    let fixture = selectionFixture(ws)
      .withNewFile("two/library/src/main/java/example/Broken.java", "package example;\nclass Broken { int x = undefinedSymbol; }\n")
    selectedCheck(
      ws,
      fixture,
      selectionArgs,
      passed: 3,
      failed: 3,
      messages: [
        "Maven tests in two/library: Maven failed in module two/library",
        "COMPILATION ERROR",
        "example.SecondTest did not run",
        "Maven stopped building it after failures in: two/library",
      ],
    )
  }

  """
  A failing class without a check fails its module's checks, not verify too.
  """
  selectedUncheckedFailureCheck(ws: Workspace!): Void @check {
    let fixture = directory.withDirectory(
      "reporting",
      fixture(ws).withNewFile("app/src/test/java/example/AppIT.java", javaClass(
        "AppIT",
        "org.junit.Assert.fail(\"integration sentinel\");",
      )),
    )
    selectedCheck(
      ws,
      fixture,
      [],
      passed: 1,
      failed: 1,
      messages: [
        "maven-module=reporting/app&maven-test=example.AppTest",
        "failures in test classes without selected test checks: reporting/app/example.AppIT",
        "integration sentinel",
      ],
    )
  }

  """
  A selected class that Surefire never runs fails rather than passing.
  """
  selectedNotRunCheck(ws: Workspace!): Void @check {
    let fixture = selectionFixture(ws).withNewFile(
      "one/app/src/test/java/example/AbstractTest.java",
      "package example;\npublic abstract class AbstractTest {\n  @org.junit.Test public void run() {}\n}\n",
    )
    selectedCheck(
      ws,
      fixture,
      selectionArgs + ["--maven-test=example.AbstractTest"],
      passed: 6,
      failed: 1,
      messages: ["example.AbstractTest did not run"],
    )
  }

  """
  Selected checks share one Maven command per reactor.
  """
  selectedDedupCheck(ws: Workspace!): Void @check {
    # The inner session evaluates every check afresh, and its progress shows
    # each distinct Maven command once, whether it ran or came from the cache.
    let result = selectedRun(ws, selectionFixture(ws), ["--progress=plain", "-vvv"] + selectionArgs)
    let output = result.stdout + result.stderr
    assert(result.exitCode == 0, "selected checks failed:\n" + output)
    let runs = output.split("\n").filter { line => line.contains("withExec mvn ") }
    assert(runs.length == 2, "expected one Maven command per reactor, got " + `${runs.length}` + ":\n" + runs.join("\n"))
    null
  }

  # Reactor two gains a module without test classes that fails to compile.
  # Nothing depends on it, so --fail-at-end still builds every other module.
  let brokenExtra(fixture: Directory!): Directory! {
    fixture
      .withNewFile(
        "two/pom.xml",
        fixture.file("two/pom.xml").contents.replace(
          old: "<module>app</module>",
          new: "<module>app</module><module>extra</module>",
        ),
      )
      .withNewFile(
        "two/extra/pom.xml",
        "<project xmlns=\"http://maven.apache.org/POM/4.0.0\"><modelVersion>4.0.0</modelVersion><parent><groupId>io.dagger.maven.fixture</groupId><artifactId>reactor</artifactId><version>1.0-SNAPSHOT</version></parent><artifactId>extra</artifactId></project>\n",
      )
      .withNewFile("two/extra/src/main/java/example/Extra.java", "package example;\nclass Extra { int x = undefinedSymbol; }\n")
  }

  """
  A failing module blames only its own classes; other modules pass on their own.
  """
  selectedModuleFailureCheck(ws: Workspace!): Void @check {
    # Broken.java is not a test class candidate, so only the module can own it.
    let fixture = selectionFixture(ws)
      .withNewFile("two/app/src/test/java/example/Broken.java", "package example;\nclass Broken { int x = undefinedSymbol; }\n")
    selectedCheck(
      ws,
      fixture,
      selectionArgs,
      passed: 4,
      failed: 2,
      messages: ["Maven tests in two/app: Maven failed in module two/app", "maven-module=two/app&maven-test=example.SecondTest"],
    )
  }

  """
  In a narrowed run, a failure in a module without selected classes fails every
  selected class sharing the command: no verify check is there to own it.
  """
  selectedOutsideFailureCheck(ws: Workspace!): Void @check {
    selectedCheck(
      ws,
      brokenExtra(selectionFixture(ws)),
      selectionArgs,
      passed: 3,
      failed: 3,
      messages: ["Maven failed in modules without selected test checks: two/extra"],
    )
  }

  """
  In a whole run, verify alone owns a failure in a module without test classes.
  """
  selectedVerifyOwnsCheck(ws: Workspace!): Void @check {
    selectedCheck(
      ws,
      brokenExtra(passingFixture(ws)),
      [],
      passed: 7,
      failed: 1,
      messages: ["dag://?check=verify&maven-project=two", "Maven failed in modules without selected test checks: two/extra"],
    )
  }

  """
  Listing discovers classes from workspace files alone: it runs no container,
  so broken POMs and unresolvable dependencies still list.
  """
  selectedListCheck(ws: Workspace!): Void @check {
    let base = passingFixture(ws)
    let fixture = base
      .withNewFile("two/library/pom.xml", "<project><unclosed>")
      .withNewFile(
        "two/app/pom.xml",
        base.file("two/app/pom.xml").contents.replace(
          old: "<dependencies>",
          new: "<dependencies><dependency><groupId>io.dagger.missing</groupId><artifactId>missing</artifactId><version>0</version></dependency>",
        ),
      )
    let result = selectedRun(ws, fixture, ["-l", "--all", "--progress=plain", "-vvv"])
    let output = result.stdout + result.stderr
    assert(result.exitCode == 0, "listing failed:\n" + output)
    ["one/app", "two/app", "two/library", "example.SecondTest", "example.LibraryTest"].map { key =>
      assert(output.contains(key), "listing lost " + key + ":\n" + output)
    }
    let execs = output.split("\n").filter { line => line.contains("withExec") }
    assert(execs.isEmpty, "listing ran a container:\n" + execs.join("\n"))
    null
  }
}
